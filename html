            {
              type: "진심 전달형",
              script: `"너랑 불편한 상태로 지내는 게 마음이 너무 안 좋아. 나는 너와의 관계를 여전히 소중하게 생각해."`,
              explanation: "상대방이 느끼고 있을지 모를 관계 소외감과 불안을 완화해 주는 확신을 줍니다."
            },
            {
              type: "대화 물꼬 터주기형",
              script: `"지금 당장 이야기하기 부담스러우면 너 편할 때 답장 줘도 돼. 천천히 이야기하자."`,
              explanation: "상대방에게 심리적 압박감을 주지 않는 여유 있는 태도를 보여줍니다."
            }
          ],
          actionGuide: `친구의 일시적인 차가움이 나의 가치를 결정짓지 않습니다. 진심을 전달한 후에는 상대방이 마음을 열 시간이 필요함을 인정해 주세요.`
        };
      }
    }

    // Render Step 5 Report
    function renderReport() {
      const data = state.report;

      document.getElementById('reportEmpathyText').innerText = data.empathyText;
      document.getElementById('reportRelationTag').innerText = `${state.relation} 갈등 해독`;
      document.getElementById('reportSurfaceWords').innerText = `"${state.partnerWords}"`;
      document.getElementById('reportHiddenMeaning').innerText = data.hiddenMeaning;
      document.getElementById('reportDeepPsychology').innerText = data.deepPsychology;
      document.getElementById('reportActionGuide').innerText = data.actionGuide;

      // Render solution cards
      const container = document.getElementById('solutionCardsContainer');
      container.innerHTML = '';

      const badgeColors = {
        '감정 완화형': 'bg-emerald-50 text-emerald-600 border-emerald-200',
        '진심 전달형': 'bg-blue-50 text-tossBlue border-blue-200',
        '대화 물꼬 터주기형': 'bg-purple-50 text-purple-600 border-purple-200'
      };

      data.solutions.forEach((sol, idx) => {
        const card = document.createElement('div');
        const colorClass = badgeColors[sol.type] || 'bg-gray-50 text-gray-600 border-gray-200';
        
        card.className = 'bg-white border border-tossBorder p-4 rounded-2xl space-y-2.5 shadow-tossSm hover:border-tossBlue/50 transition-all';
        card.innerHTML = `
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full border ${colorClass}">
              유형 ${idx+1}: ${sol.type}
            </span>
            <button onclick="copyScript('${sol.script.replace(/'/g, "\\'")}', this)" class="text-xs text-tossSubText hover:text-tossBlue flex items-center gap-1 font-medium bg-tossLightBg px-2.5 py-1 rounded-lg transition-all">
              <i class="ph-bold ph-copy"></i> 복사
            </button>
          </div>
          <p class="text-sm font-bold text-tossDarkText leading-snug bg-tossLightBg/60 p-3 rounded-xl border border-tossBorder/50">
            ${sol.script}
          </p>
          <p class="text-xs text-tossSubText leading-relaxed">
            💡 <span class="font-medium text-tossDarkText/80">효과:</span> ${sol.explanation}
          </p>
        `;
        container.appendChild(card);
      });
    }

    // Copying Script Function
    function copyScript(text, btn) {
      const tempInput = document.createElement('textarea');
      tempInput.value = text;
      document.body.appendChild(tempInput);
      tempInput.select();
      document.execCommand('copy');
      document.body.removeChild(tempInput);

      const originalText = btn.innerHTML;
      btn.innerHTML = `<i class="ph-bold ph-check text-emerald-500"></i> 복사됨!`;
      btn.classList.add('text-emerald-600', 'bg-emerald-50');
      setTimeout(() => {
        btn.innerHTML = originalText;
        btn.classList.remove('text-emerald-600', 'bg-emerald-50');
      }, 2000);
    }

    // Copy Full Summary Report
    function copyFullReport() {
      if (!state.report) return;

      const r = state.report;
      let text = `[DECODE 대화 해독 리포트]\n\n`;
      text += `📍 상대와의 관계: ${state.relation}\n`;
      text += `🗣️ 상대방의 말: "${state.partnerWords}"\n\n`;
      text += `🧠 심리학적 속뜻:\n${r.hiddenMeaning}\n\n`;
      text += `💡 현명한 추천 대답:\n`;
      r.solutions.forEach((s, idx) => {
        text += `${idx+1}. [${s.type}] ${s.script}\n`;
      });

      const tempInput = document.createElement('textarea');
      tempInput.value = text;
      document.body.appendChild(tempInput);
      tempInput.select();
      document.execCommand('copy');
      document.body.removeChild(tempInput);

      alert('전체 요약 리포트가 클립보드에 복사되었습니다.');
    }

    // Initialize App
    window.onload = function() {
      goToStep(1);
    };
  </script>
</body>
</html>
