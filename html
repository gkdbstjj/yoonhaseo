<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DECODE - 대화 암호 해독 & 갈등 해결 AI</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Inter Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- Phosphor Icons -->
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            tossBlue: '#3182F6',
            tossBlueHover: '#1B64DA',
            tossLightBg: '#F2F4F6',
            tossDarkText: '#191F28',
            tossSubText: '#8B95A1',
            tossCardBg: '#FFFFFF',
            tossBorder: '#E5E8EB',
          },
          fontFamily: {
            sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'Apple SD Gothic Neo', 'Malgun Gothic', 'sans-serif'],
          },
          boxShadow: {
            toss: '0 8px 30px rgba(0, 0, 0, 0.06)',
            tossSm: '0 2px 10px rgba(0, 0, 0, 0.04)',
          }
        }
      }
    }
  </script>
  <style>
    body {
      background-color: #F2F4F6;
      color: #191F28;
      word-break: keep-all;
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #f1f1f1;
      border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #ccc;
      border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #aaa;
    }
    @keyframes pulseGlow {
      0%, 100% { opacity: 0.4; transform: scale(0.98); }
      50% { opacity: 0.8; transform: scale(1.02); }
    }
    .animate-pulse-glow {
      animation: pulseGlow 3s infinite ease-in-out;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-start p-4 sm:p-6 md:p-8">

  <!-- Main Container -->
  <div class="w-full max-w-xl bg-white rounded-3xl shadow-toss border border-tossBorder overflow-hidden flex flex-col min-h-[720px] transition-all duration-300">
    
    <!-- Header -->
    <header class="p-5 border-b border-tossBorder flex items-center justify-between bg-white sticky top-0 z-20">
      <div class="flex items-center gap-2 cursor-pointer" onclick="resetToStep1()">
        <div class="w-9 h-9 bg-tossBlue/10 text-tossBlue rounded-2xl flex items-center justify-center font-bold text-lg">
          <i class="ph-bold ph-keyhole text-tossBlue"></i>
        </div>
        <div>
          <h1 class="font-bold text-lg text-tossDarkText tracking-tight flex items-center gap-1.5">
            DECODE <span class="text-xs px-2 py-0.5 rounded-full bg-tossBlue/10 text-tossBlue font-semibold">AI 심리해독</span>
          </h1>
          <p class="text-xs text-tossSubText">말 속에 숨겨진 진심과 갈등 해결책</p>
        </div>
      </div>
      <button onclick="resetToStep1()" title="처음으로" class="text-tossSubText hover:text-tossDarkText text-xs font-medium bg-tossLightBg px-3 py-1.5 rounded-full transition-all">
        <i class="ph-bold ph-arrows-counter-clockwise mr-1"></i>새로 해독
      </button>
    </header>

    <!-- Progress Indicator Bar -->
    <div class="w-full bg-tossLightBg h-1.5 overflow-hidden">
      <div id="progressBar" class="bg-tossBlue h-full w-1/5 transition-all duration-500 ease-out"></div>
    </div>

    <!-- Main Content Area -->
    <main class="flex-1 p-6 flex flex-col justify-between relative overflow-y-auto custom-scrollbar">

      <!-- STEP 1: Relative & Personality Selection -->
      <section id="step1" class="space-y-6 animate-fadeIn">
        <div>
          <span class="text-xs font-bold text-tossBlue bg-tossBlue/10 px-2.5 py-1 rounded-full">STEP 1</span>
          <h2 class="text-2xl font-bold mt-2 text-tossDarkText">누구와의 대화에서<br>상처받거나 갈등이 생겼나요?</h2>
          <p class="text-sm text-tossSubText mt-1">상대방과의 관계와 특성을 선택해주세요.</p>
        </div>

        <div class="space-y-4">
          <label class="block text-xs font-semibold text-tossSubText uppercase tracking-wider">상대와의 관계</label>
          <div class="grid grid-cols-2 gap-2.5" id="relationGrid">
            <button onclick="selectRelation('부모님 (엄마/아빠)', this)" class="relation-btn p-3.5 border border-tossBorder rounded-2xl text-left font-medium text-sm hover:border-tossBlue flex items-center justify-between transition-all bg-white">
              <span><i class="ph-duotone ph-house-line text-lg mr-2 text-tossBlue"></i>부모님</span>
              <i class="ph-bold ph-check text-tossBlue opacity-0 check-icon"></i>
            </button>
            <button onclick="selectRelation('형제/자매', this)" class="relation-btn p-3.5 border border-tossBorder rounded-2xl text-left font-medium text-sm hover:border-tossBlue flex items-center justify-between transition-all bg-white">
              <span><i class="ph-duotone ph-users text-lg mr-2 text-tossBlue"></i>형제/자매</span>
              <i class="ph-bold ph-check text-tossBlue opacity-0 check-icon"></i>
            </button>
            <button onclick="selectRelation('친구', this)" class="relation-btn p-3.5 border border-tossBorder rounded-2xl text-left font-medium text-sm hover:border-tossBlue flex items-center justify-between transition-all bg-white">
              <span><i class="ph-duotone ph-smiley text-lg mr-2 text-tossBlue"></i>친구</span>
              <i class="ph-bold ph-check text-tossBlue opacity-0 check-icon"></i>
            </button>
            <button onclick="selectRelation('선생님/선배/기타', this)" class="relation-btn p-3.5 border border-tossBorder rounded-2xl text-left font-medium text-sm hover:border-tossBlue flex items-center justify-between transition-all bg-white">
              <span><i class="ph-duotone ph-graduation-cap text-lg mr-2 text-tossBlue"></i>선생님/기타</span>
              <i class="ph-bold ph-check text-tossBlue opacity-0 check-icon"></i>
            </button>
          </div>
        </div>

        <div class="space-y-3">
          <label class="block text-xs font-semibold text-tossSubText uppercase tracking-wider">상대방의 성향/평소 태도 (선택)</label>
          <div class="flex flex-wrap gap-2" id="traitBadgeContainer">
            <button onclick="toggleTrait('권위적임/엄격함', this)" class="trait-badge px-3.5 py-2 rounded-xl border border-tossBorder text-xs text-tossDarkText font-medium hover:bg-tossLightBg transition-all">#권위적임/엄격함</button>
            <button onclick="toggleTrait('걱정/염려가 많음', this)" class="trait-badge px-3.5 py-2 rounded-xl border border-tossBorder text-xs text-tossDarkText font-medium hover:bg-tossLightBg transition-all">#걱정이 많음</button>
            <button onclick="toggleTrait('감정 기복이 크다', this)" class="trait-badge px-3.5 py-2 rounded-xl border border-tossBorder text-xs text-tossDarkText font-medium hover:bg-tossLightBg transition-all">#감정적임</button>
            <button onclick="toggleTrait('직설적임/차가움', this)" class="trait-badge px-3.5 py-2 rounded-xl border border-tossBorder text-xs text-tossDarkText font-medium hover:bg-tossLightBg transition-all">#직설적/차가움</button>
            <button onclick="toggleTrait('회피형/말을 아낌', this)" class="trait-badge px-3.5 py-2 rounded-xl border border-tossBorder text-xs text-tossDarkText font-medium hover:bg-tossLightBg transition-all">#말을 아낌/회피형</button>
            <button onclick="toggleTrait('비교를 자주 함', this)" class="trait-badge px-3.5 py-2 rounded-xl border border-tossBorder text-xs text-tossDarkText font-medium hover:bg-tossLightBg transition-all">#자주 비교함</button>
          </div>
        </div>

        <div class="pt-4">
          <button id="step1NextBtn" onclick="goToStep(2)" disabled class="w-full py-4 rounded-2xl bg-tossLightBg text-tossSubText font-semibold text-base transition-all disabled:opacity-60 cursor-not-allowed">
            다음 단계로
          </button>
        </div>
      </section>

      <!-- STEP 2: Input Partner's Words -->
      <section id="step2" class="space-y-6 hidden animate-fadeIn">
        <div>
          <span class="text-xs font-bold text-tossBlue bg-tossBlue/10 px-2.5 py-1 rounded-full">STEP 2</span>
          <h2 class="text-2xl font-bold mt-2 text-tossDarkText"><span id="partnerNameDisplay">상대방</span>이(가) 어떤 말을 했나요?</h2>
          <p class="text-sm text-tossSubText mt-1">상대방이 한 말이나 카톡 내용을 그대로 적어주세요.</p>
        </div>

        <div class="space-y-3">
          <label class="block text-xs font-semibold text-tossSubText uppercase tracking-wider">들었던 말 (직접 입력 또는 예시 선택)</label>
          <textarea id="targetWords" rows="4" placeholder="예: '다 너 잘되라고 하는 말인데 왜 그렇게 공격적으로 받아들여?' 또는 '알아서 해라 이제 안 참는다'"
            class="w-full p-4 rounded-2xl border border-tossBorder focus:border-tossBlue focus:ring-2 focus:ring-tossBlue/20 outline-none text-sm text-tossDarkText placeholder:text-tossSubText transition-all resize-none"></textarea>
          
          <!-- Preset quick-select chips according to relation -->
          <div class="space-y-1.5">
            <p class="text-xs text-tossSubText font-medium">✨ 자주 나오는 갈등 상황 문장 선택하기:</p>
            <div id="presetWordsContainer" class="flex flex-col gap-1.5">
              <!-- Dynamically filled by JS -->
            </div>
          </div>
        </div>

        <div class="flex gap-3 pt-4">
          <button onclick="goToStep(1)" class="w-1/3 py-4 rounded-2xl bg-tossLightBg text-tossDarkText font-semibold text-sm hover:bg-gray-200 transition-all">
            이전
          </button>
          <button id="step2NextBtn" onclick="goToStep(3)" disabled class="w-2/3 py-4 rounded-2xl bg-tossLightBg text-tossSubText font-semibold text-base transition-all disabled:opacity-60 cursor-not-allowed">
            다음 단계로
          </button>
        </div>
      </section>

      <!-- STEP 3: User's Emotion & Heart -->
      <section id="step3" class="space-y-6 hidden animate-fadeIn">
        <div>
          <span class="text-xs font-bold text-tossBlue bg-tossBlue/10 px-2.5 py-1 rounded-full">STEP 3</span>
          <h2 class="text-2xl font-bold mt-2 text-tossDarkText">그 말을 들었을 때<br>마음이 어땠나요?</h2>
          <p class="text-sm text-tossSubText mt-1">솔직한 솔루션을 위해 당시 느낀 감정을 골라주세요.</p>
        </div>

        <div class="space-y-3">
          <label class="block text-xs font-semibold text-tossSubText uppercase tracking-wider">주된 감정 (다중 선택 가능)</label>
          <div class="grid grid-cols-2 gap-2.5">
            <button onclick="toggleEmotion('억울함/오해받음', this)" class="emotion-btn p-3 border border-tossBorder rounded-xl text-xs font-medium text-tossDarkText text-left hover:border-tossBlue transition-all flex items-center justify-between">
              <span>🥺 억울함/억압받는 느낌</span>
            </button>
            <button onclick="toggleEmotion('서운함/배신감', this)" class="emotion-btn p-3 border border-tossBorder rounded-xl text-xs font-medium text-tossDarkText text-left hover:border-tossBlue transition-all flex items-center justify-between">
              <span>💔 서운함/상처받음</span>
            </button>
            <button onclick="toggleEmotion('답답함/벽창호같음', this)" class="emotion-btn p-3 border border-tossBorder rounded-xl text-xs font-medium text-tossDarkText text-left hover:border-tossBlue transition-all flex items-center justify-between">
              <span>😤 답답함/말이 안 통함</span>
            </button>
            <button onclick="toggleEmotion('죄책감/부담감', this)" class="emotion-btn p-3 border border-tossBorder rounded-xl text-xs font-medium text-tossDarkText text-left hover:border-tossBlue transition-all flex items-center justify-between">
              <span>🌧️ 죄책감/학업/진로 부담</span>
            </button>
            <button onclick="toggleEmotion('분노/화남', this)" class="emotion-btn p-3 border border-tossBorder rounded-xl text-xs font-medium text-tossDarkText text-left hover:border-tossBlue transition-all flex items-center justify-between">
              <span>🔥 화남/선 넘음</span>
            </button>
            <button onclick="toggleEmotion('포기하고 싶음/포기', this)" class="emotion-btn p-3 border border-tossBorder rounded-xl text-xs font-medium text-tossDarkText text-left hover:border-tossBlue transition-all flex items-center justify-between">
              <span>😮‍💨 무기력/지침</span>
            </button>
          </div>
        </div>

        <div class="space-y-2">
          <label class="block text-xs font-semibold text-tossSubText uppercase tracking-wider">내가 정말 하고 싶었던 속마음 (선택)</label>
          <input id="userInnerFeeling" type="text" placeholder="예: 제 입장도 조금만 들어주시면 좋겠어요."
            class="w-full p-3.5 rounded-2xl border border-tossBorder focus:border-tossBlue focus:ring-2 focus:ring-tossBlue/20 outline-none text-sm text-tossDarkText placeholder:text-tossSubText transition-all">
        </div>

        <div class="flex gap-3 pt-4">
          <button onclick="goToStep(2)" class="w-1/3 py-4 rounded-2xl bg-tossLightBg text-tossDarkText font-semibold text-sm hover:bg-gray-200 transition-all">
            이전
          </button>
          <button id="step3NextBtn" onclick="startDecoding()" disabled class="w-2/3 py-4 rounded-2xl bg-tossLightBg text-tossSubText font-semibold text-base transition-all disabled:opacity-60 cursor-not-allowed">
            암호 해독 시작하기
          </button>
        </div>
      </section>

      <!-- STEP 4: AI Decoding Loading Screen -->
      <section id="step4" class="hidden my-auto flex flex-col items-center justify-center text-center py-12 space-y-8 animate-fadeIn">
        <div class="relative w-24 h-24 flex items-center justify-center">
          <div class="absolute inset-0 bg-tossBlue/20 rounded-full animate-ping opacity-75"></div>
          <div class="relative w-20 h-20 bg-tossBlue text-white rounded-3xl flex items-center justify-center text-3xl shadow-lg shadow-tossBlue/30">
            <i class="ph-bold ph-brain animate-bounce"></i>
          </div>
        </div>

        <div class="space-y-2">
          <h3 id="loadingStatusText" class="text-xl font-bold text-tossDarkText transition-all">
            상대방의 말 속 진짜 마음을 정밀 해독하는 중...
          </h3>
          <p id="loadingSubText" class="text-sm text-tossSubText">
            심리학적 맥락과 감정 역학 관계를 다각도로 분석하고 있습니다
          </p>
        </div>

        <!-- Step animation check list -->
        <div class="w-full max-w-xs bg-tossLightBg p-4 rounded-2xl space-y-2.5 text-xs text-left font-medium text-tossSubText">
          <div id="loadCheck1" class="flex items-center gap-2 transition-all">
            <i class="ph-bold ph-circle text-tossSubText" id="icon1"></i>
            <span>선택하신 관계 및 분위기 맥락 파악 중</span>
          </div>
          <div id="loadCheck2" class="flex items-center gap-2 transition-all">
            <i class="ph-bold ph-circle text-tossSubText" id="icon2"></i>
            <span>방어기제 및 방어적 표면언어 분리</span>
          </div>
          <div id="loadCheck3" class="flex items-center gap-2 transition-all">
            <i class="ph-bold ph-circle text-tossSubText" id="icon3"></i>
            <span>현실적인 감정 완화 & 진심 대화 솔루션 구성</span>
          </div>
        </div>
      </section>

      <!-- STEP 5: Detailed Report Screen -->
      <section id="step5" class="space-y-6 hidden animate-fadeIn">
        
        <!-- Empathy Banner -->
        <div class="bg-blue-50 border border-blue-100 p-4 rounded-2xl flex items-start gap-3">
          <div class="w-8 h-8 rounded-full bg-tossBlue text-white flex items-center justify-center shrink-0 text-base font-bold mt-0.5">
            <i class="ph-bold ph-heart font-bold"></i>
          </div>
          <div>
            <h4 class="text-xs font-bold text-tossBlue">DECODE의 마음 공감</h4>
            <p id="reportEmpathyText" class="text-xs text-tossDarkText mt-1 leading-relaxed font-medium">
              마음고생이 정말 많았겠어요. 상대방과의 대화에서 느꼈을 서운함과 답답함은 지극히 당연한 감정입니다.
            </p>
          </div>
        </div>

        <!-- Section 1: Decoding Surface vs Hidden Reality -->
        <div class="bg-white border border-tossBorder rounded-2xl p-5 shadow-tossSm space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-tossBlue uppercase tracking-wider">심리 구조 해독</span>
            <span id="reportRelationTag" class="text-[11px] px-2.5 py-0.5 rounded-full bg-tossLightBg text-tossSubText font-semibold">부모님 갈등 분석</span>
          </div>

          <div class="space-y-3 pt-1">
            <!-- 표면적 말 -->
            <div class="bg-red-50/60 border border-red-100 p-3.5 rounded-xl">
              <span class="text-[11px] font-bold text-red-500 uppercase tracking-wider block mb-1">
                🗣️ 상대방이 겉으로 던진 말 (표면 언어)
              </span>
              <p id="reportSurfaceWords" class="text-sm font-semibold text-red-900 italic">
                "다 너 잘되라고 하는 말인데 왜 말을 그렇게 해?"
              </p>
            </div>

            <div class="flex justify-center my-1 text-tossSubText text-sm">
              <i class="ph-bold ph-arrow-down"></i>
            </div>

            <!-- 속마음 & 심리 맥락 -->
            <div class="bg-blue-50/50 border border-tossBlue/20 p-4 rounded-xl space-y-2">
              <span class="text-[11px] font-bold text-tossBlue uppercase tracking-wider block">
                🧠 심리학적 속뜻 & 숨겨진 의도 (숨은 암호)
              </span>
              <p id="reportHiddenMeaning" class="text-sm text-tossDarkText leading-relaxed font-normal">
                분석 데이터를 로딩 중입니다...
              </p>
            </div>
          </div>
        </div>

        <!-- Section 2: Deep Psychological Dynamic -->
        <div class="bg-tossLightBg/80 p-4 rounded-2xl space-y-2">
          <h4 class="text-xs font-bold text-tossDarkText flex items-center gap-1.5">
            <i class="ph-bold ph-magnifying-glass-plus text-tossBlue"></i> 왜 이런 갈등 양상이 나타났을까요?
          </h4>
          <p id="reportDeepPsychology" class="text-xs text-tossDarkText/80 leading-relaxed">
            관계의 특성과 불안 요소가 맞물려 발생한 현상입니다.
          </p>
        </div>

        <!-- Section 3: Recommended Responses (3 Cards) -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <h3 class="text-base font-bold text-tossDarkText">💡 현명하게 대처하는 추천 대답 3가지</h3>
            <span class="text-[11px] text-tossSubText">복사하여 바로 사용 가능</span>
          </div>

          <div id="solutionCardsContainer" class="space-y-3">
            <!-- Cards inserted via JS -->
          </div>
        </div>

        <!-- Section 4: Actionable Advice for Student -->
        <div class="bg-amber-50/60 border border-amber-200/60 p-4 rounded-2xl space-y-2">
          <h4 class="text-xs font-bold text-amber-800 flex items-center gap-1.5">
            <i class="ph-bold ph-compass text-amber-600"></i> 앞으로를 위한 마음 가이드
          </h4>
          <p id="reportActionGuide" class="text-xs text-amber-900/80 leading-relaxed font-normal">
            가이드라인 로딩 중...
          </p>
        </div>

        <!-- Bottom Action Buttons -->
        <div class="pt-2 flex flex-col gap-2">
          <button onclick="copyFullReport()" class="w-full py-3.5 rounded-2xl bg-tossLightBg hover:bg-gray-200 text-tossDarkText font-semibold text-sm transition-all flex items-center justify-center gap-2">
            <i class="ph-bold ph-copy"></i> 전체 리포트 요약 복사하기
          </button>
          <button onclick="resetToStep1()" class="w-full py-3.5 rounded-2xl bg-tossBlue text-white font-semibold text-sm hover:bg-tossBlueHover transition-all flex items-center justify-center gap-2 shadow-sm">
            <i class="ph-bold ph-arrows-counter-clockwise"></i> 다른 대화 내용 해독해보기
          </button>
        </div>

      </section>

    </main>
  </div>

  <script>
    // State management
    const state = {
      relation: '',
      traits: [],
      partnerWords: '',
      emotions: [],
      userInner: '',
      report: null
    };

    // Relation Preset Words
    const PRESETS = {
      '부모님 (엄마/아빠)': [
        "다 너 잘되라고 하는 소리인데 왜 그렇게 화를 내니?",
