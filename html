<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DECODE - 꼬인 대화 암호 해독기</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Pretendard', '-apple-system', 'BlinkMacSystemFont', 'system-ui', 'Roboto', 'sans-serif'],
          },
          colors: {
            toss: {
              blue: '#3182F6',
              blueHover: '#1B64DA',
              lightBlue: '#E8F3FF',
              greyBg: '#F2F4F6',
              greyText: '#8B95A1',
              darkText: '#191F28',
              cardBg: '#FFFFFF',
              border: '#E5E8EB',
              badgeBg: '#F9FAFB'
            }
          },
          animation: {
            'bounce-slow': 'bounce 2s infinite',
            'pulse-fast': 'pulse 1.2s cubic-bezier(0.4, 0, 0.6, 1) infinite',
            'fade-in': 'fadeIn 0.4s ease-out forwards',
            'slide-up': 'slideUp 0.4s ease-out forwards'
          },
          keyframes: {
            fadeIn: {
              '0%': { opacity: '0' },
              '100%': { opacity: '1' }
            },
            slideUp: {
              '0%': { opacity: '0', transform: 'translateY(20px)' },
              '100%': { opacity: '1', transform: 'translateY(0)' }
            }
          }
        }
      }
    }
  </script>
  <style>
    /* Custom scrollbar for mobile feel */
    ::-webkit-scrollbar {
      width: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: #D1D5DB;
      border-radius: 9999px;
    }
    .step-content {
      display: none;
    }
    .step-content.active {
      display: block;
      animation: slideUp 0.4s ease-out forwards;
    }
  </style>
</head>
<body class="bg-[#E9ECEF] text-toss-darkText font-sans min-h-screen flex justify-center items-center p-0 md:p-4 selection:bg-toss-lightBlue selection:text-toss-blue">

  <div class="w-full max-w-md bg-toss-greyBg min-h-screen md:min-h-[840px] md:max-h-[920px] md:rounded-[36px] shadow-2xl flex flex-col justify-between overflow-hidden relative border border-gray-200/50">
    
    <!-- Top Header -->
    <header class="bg-white px-6 py-4 flex justify-between items-center sticky top-0 z-20 border-b border-toss-border/60">
      <div class="flex items-center space-x-2 cursor-pointer" onclick="resetApp()">
        <div class="w-8 h-8 rounded-xl bg-toss-blue flex items-center justify-center text-white font-black text-lg shadow-sm">
          🔓
        </div>
        <span class="font-bold text-xl tracking-tight text-toss-darkText">DECODE</span>
      </div>
      <div id="stepProgress" class="text-xs font-semibold px-3 py-1 rounded-full bg-toss-lightBlue text-toss-blue">
        STEP 1 / 4
      </div>
    </header>

    <!-- Main Content Area (Step Container) -->
    <main id="appContainer" class="flex-1 overflow-y-auto px-6 py-6 pb-24">
      
      <!-- ==================== STEP 1: 관계 및 상황 ==================== -->
      <section id="step1" class="step-content active space-y-6">
        <div>
          <span class="text-3xl mb-2 block">🤝</span>
          <h1 class="text-2xl font-bold text-toss-darkText leading-snug">
            누구와 어떤 일로<br>대화가 꼬였나요?
          </h1>
          <p class="text-toss-greyText text-sm mt-1">상대방과의 관계를 알려주시면 정확도가 올라가요!</p>
        </div>

        <!-- 관계 선택 버튼 -->
        <div class="space-y-2">
          <label class="block text-xs font-bold text-toss-greyText uppercase tracking-wider">상대와의 관계</label>
          <div class="grid grid-cols-2 gap-2" id="relationGroup">
            <button type="button" data-val="베프(절친)" onclick="selectRelation(this)" class="rel-btn text-left p-3.5 rounded-2xl bg-white border border-toss-border font-medium text-sm flex items-center space-x-2 transition hover:bg-gray-50 focus:outline-none">
              <span class="text-lg">💖</span> <span>베프 (절친)</span>
            </button>
            <button type="button" data-val="반 친구" onclick="selectRelation(this)" class="rel-btn text-left p-3.5 rounded-2xl bg-white border border-toss-border font-medium text-sm flex items-center space-x-2 transition hover:bg-gray-50 focus:outline-none">
              <span class="text-lg">🏫</span> <span>같은 반 친구</span>
            </button>
            <button type="button" data-val="동아리/선후배" onclick="selectRelation(this)" class="rel-btn text-left p-3.5 rounded-2xl bg-white border border-toss-border font-medium text-sm flex items-center space-x-2 transition hover:bg-gray-50 focus:outline-none">
              <span class="text-lg">🎈</span> <span>동아리 / 선후배</span>
            </button>
            <button type="button" data-val="가족" onclick="selectRelation(this)" class="rel-btn text-left p-3.5 rounded-2xl bg-white border border-toss-border font-medium text-sm flex items-center space-x-2 transition hover:bg-gray-50 focus:outline-none">
              <span class="text-lg">🏠</span> <span>가족 (부모/형제)</span>
            </button>
          </div>
        </div>

        <!-- 상대 성격 태그 -->
        <div class="space-y-2">
          <label class="block text-xs font-bold text-toss-greyText uppercase tracking-wider">상대방의 평소 성격</label>
          <div class="flex flex-wrap gap-2" id="personalityGroup">
            <button type="button" onclick="togglePersonality(this, '직설적임')" class="pers-btn text-xs font-medium px-3.5 py-2 rounded-xl bg-white border border-toss-border text-gray-700 hover:bg-gray-50">#직설적임</button>
            <button type="button" onclick="togglePersonality(this, '자존심 강함')" class="pers-btn text-xs font-medium px-3.5 py-2 rounded-xl bg-white border border-toss-border text-gray-700 hover:bg-gray-50">#자존심 강함</button>
            <button type="button" onclick="togglePersonality(this, '말을 아낌')" class="pers-btn text-xs font-medium px-3.5 py-2 rounded-xl bg-white border border-toss-border text-gray-700 hover:bg-gray-50">#말을 아낌</button>
            <button type="button" onclick="togglePersonality(this, '서운함 잘 느낌')" class="pers-btn text-xs font-medium px-3.5 py-2 rounded-xl bg-white border border-toss-border text-gray-700 hover:bg-gray-50">#서운함 잘 느낌</button>
            <button type="button" onclick="togglePersonality(this, '장난기 많음')" class="pers-btn text-xs font-medium px-3.5 py-2 rounded-xl bg-white border border-toss-border text-gray-700 hover:bg-gray-50">#장난기 많음</button>
          </div>
        </div>

        <!-- 갈등 상황 입력 -->
        <div class="space-y-2">
          <label class="block text-xs font-bold text-toss-greyText uppercase tracking-wider">어떤 상황이었나요?</label>
          <textarea id="situationInput" rows="3" placeholder="예: 약속 시간에 30분 늦었는데, 카톡 읽씹하고 분위기가 차가워졌어..." class="w-full p-4 rounded-2xl bg-white border border-toss-border focus:border-toss-blue focus:ring-2 focus:ring-toss-lightBlue outline-none text-sm resize-none placeholder:text-gray-400 leading-relaxed"></textarea>
        </div>
      </section>

      <!-- ==================== STEP 2: 상대의 말 정리 ==================== -->
      <section id="step2" class="step-content space-y-6">
        <div>
          <span class="text-3xl mb-2 block">💬</span>
          <h1 class="text-2xl font-bold text-toss-darkText leading-snug">
            상대방이 나에게했던<br>말이나 카톡은?
          </h1>
          <p class="text-toss-greyText text-sm mt-1">상대의 차가운 한마디, 혹은 헷갈리는 문장 그대로 적어주세요.</p>
        </div>

        <div class="bg-white rounded-3xl p-5 border border-toss-border shadow-sm space-y-3">
          <div class="flex items-center space-x-2">
            <div class="w-7 h-7 rounded-full bg-gray-200 flex items-center justify-center text-xs">👤</div>
            <span id="targetNameTag" class="text-xs font-semibold text-gray-600">상대방</span>
          </div>
          <textarea id="opponentMessageInput" rows="4" placeholder="예: '아냐 난 상관없어. 너 좋을 대로 해 ㅋ'" class="w-full p-3 rounded-xl bg-toss-greyBg border-none focus:ring-2 focus:ring-toss-blue outline-none text-sm leading-relaxed placeholder:text-gray-400"></textarea>
          <div class="text-right">
            <button type="button" onclick="insertSampleMessage()" class="text-xs text-toss-blue font-semibold hover:underline">💡 잘 모르겠다면 예시 입력해보기</button>
          </div>
        </div>
      </section>

      <!-- ==================== STEP 3: 나의 감정 상태 ==================== -->
      <section id="step3" class="step-content space-y-6">
        <div>
          <span class="text-3xl mb-2 block">❤️🩹</span>
          <h1 class="text-2xl font-bold text-toss-darkText leading-snug">
            지금 솔직한<br>내 마음은 어떤가요?
          </h1>
          <p class="text-toss-greyText text-sm mt-1">AI가 내 솔직한 감정을 중심으로 해결책을 짜드려요.</p>
        </div>

        <!-- 감정 키워드 태그 -->
        <div class="space-y-2">
          <label class="block text-xs font-bold text-toss-greyText uppercase tracking-wider">느끼는 감정 (복수 선택 가능)</label>
          <div class="grid grid-cols-2 gap-2.5" id="emotionGroup">
            <button type="button" onclick="toggleEmotion(this, '속상함/상처받음')" class="emo-btn p-3 rounded-2xl bg-white border border-toss-border text-left font-medium text-sm flex items-center justify-between">
              <span>😭 속상함/상처</span>
              <span class="check-icon opacity-0 text-toss-blue">✓</span>
            </button>
            <button type="button" onclick="toggleEmotion(this, '억울함/답답함')" class="emo-btn p-3 rounded-2xl bg-white border border-toss-border text-left font-medium text-sm flex items-center justify-between">
              <span>😤 억울함/답답</span>
              <span class="check-icon opacity-0 text-toss-blue">✓</span>
            </button>
            <button type="button" onclick="toggleEmotion(this, '불안함/걱정됨')" class="emo-btn p-3 rounded-2xl bg-white border border-toss-border text-left font-medium text-sm flex items-center justify-between">
              <span>😰 불안/손절걱정</span>
              <span class="check-icon opacity-0 text-toss-blue">✓</span>
            </button>
            <button type="button" onclick="toggleEmotion(this, '미안함/후회됨')" class="emo-btn p-3 rounded-2xl bg-white border border-toss-border text-left font-medium text-sm flex items-center justify-between">
              <span>🥺 미안/후회됨</span>
              <span class="check-icon opacity-0 text-toss-blue">✓</span>
            </button>
          </div>
        </div>

        <!-- 솔직한 속마음 -->
        <div class="space-y-2">
          <label class="block text-xs font-bold text-toss-greyText uppercase tracking-wider">내가 진짜 바라는 점은?</label>
          <input type="text" id="myInnerFeelInput" placeholder="예: 화풀고 다시 예전처럼 편하게 지내고 싶어..." class="w-full p-4 rounded-2xl bg-white border border-toss-border focus:border-toss-blue focus:ring-2 focus:ring-toss-lightBlue outline-none text-sm placeholder:text-gray-400">
        </div>
      </section>

      <!-- ==================== STEP 4: AI 로딩 애니메이션 ==================== -->
      <section id="step4" class="step-content text-center py-12 space-y-8">
        <div class="relative w-28 h-28 mx-auto flex items-center justify-center">
          <div class="absolute inset-0 rounded-full bg-toss-lightBlue animate-ping opacity-75"></div>
          <div class="relative w-24 h-24 rounded-full bg-toss-blue flex items-center justify-center text-4xl shadow-lg">
            🔍
          </div>
        </div>

        <div class="space-y-2">
          <h2 class="text-2xl font-bold text-toss-darkText animate-pulse">
            상대의 속뜻을 해독하고 있어요
          </h2>
          <p id="loadingStatusText" class="text-toss-blue font-semibold text-sm">
            문장 속 숨겨진 심리 파악 중...
          </p>
        </div>

        <!-- 로딩 서브 프로그래스 바 -->
        <div class="w-full bg-gray-200 h-2 rounded-full overflow-hidden">
          <div id="loadingBar" class="bg-toss-blue h-full w-0 transition-all duration-300"></div>
        </div>

        <!-- 로딩 팁 카드 -->
        <div class="bg-white p-4 rounded-2xl border border-toss-border text-left space-y-1">
          <div class="text-xs font-bold text-toss-blue">💡 알고 계셨나요?</div>
          <p class="text-xs text-gray-600 leading-relaxed">
            카톡에서 "아무거나"나 "ㅋ" 하나는 상대방의 진짜 감정이 숨겨져 있는 대표적인 '암호' 문장이에요!
          </p>
        </div>
      </section>

      <!-- ==================== STEP 5: 해독 결과 ==================== -->
      <section id="step5" class="step-content space-y-6">
        
        <!-- F 감성 공감 헤더 -->
        <div class="bg-gradient-to-br from-toss-lightBlue to-blue-50 p-5 rounded-3xl border border-blue-100 space-y-2">
          <div class="flex items-center space-x-2">
            <span class="text-xl">🫂</span>
            <span class="text-xs font-bold text-toss-blue">AI 심리 코치의 마음 공감</span>
          </div>
          <p id="resEmpathyText" class="text-sm font-semibold text-toss-darkText leading-relaxed">
            --
          </p>
        </div>

        <!-- 상황 요약 및 핵심 쟁점 -->
        <div class="bg-white p-5 rounded-3xl border border-toss-border shadow-sm space-y-3">
          <h3 class="text-xs font-bold text-toss-greyText uppercase tracking-wider flex items-center justify-between">
            <span>📌 갈등 요약 & 핵심 쟁점</span>
          </h3>
          <p id="resSummaryText" class="text-sm text-gray-700 leading-relaxed font-normal">
            --
          </p>
        </div>

        <!-- 상대방 말의 속뜻 해독 -->
        <div class="bg-white p-5 rounded-3xl border border-toss-border shadow-sm space-y-3">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold text-toss-greyText uppercase tracking-wider">🔓 상대방의 진짜 속마음 해독</h3>
            <span class="text-xs bg-red-50 text-red-500 font-bold px-2 py-0.5 rounded-md">속뜻 98% 분석</span>
          </div>
          
          <div class="bg-toss-greyBg p-3.5 rounded-2xl text-xs text-gray-600 italic border-l-4 border-toss-blue">
            "<span id="resOriginalMsg">--</span>"
          </div>

          <div class="pt-1">
            <p id="resDecodedText" class="text-sm font-bold text-toss-darkText leading-relaxed">
              --
            </p>
          </div>
        </div>

        <!-- 3가지 스타일 맞춤 대답 추천 -->
        <div class="space-y-3">
          <h3 class="text-xs font-bold text-toss-greyText uppercase tracking-wider">💬 이렇게 답장해보는 건 어떨까요?</h3>

          <!-- Option A: 다정공감형 -->
          <div class="bg-white p-4 rounded-2xl border border-toss-border shadow-sm space-y-2 hover:border-toss-blue transition">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-lg">🌱 A. 따뜻한 공감형</span>
              <button onclick="copyToClipboard('replyA')" class="text-xs text-toss-greyText hover:text-toss-blue font-medium">복사</button>
            </div>
            <p id="replyA" class="text-sm text-gray-800 font-medium leading-relaxed">--</p>
          </div>

          <!-- Option B: 솔직담백형 -->
          <div class="bg-white p-4 rounded-2xl border border-toss-border shadow-sm space-y-2 hover:border-toss-blue transition">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-toss-blue bg-toss-lightBlue px-2.5 py-1 rounded-lg">🎯 B. 솔직 담백형</span>
              <button onclick="copyToClipboard('replyB')" class="text-xs text-toss-greyText hover:text-toss-blue font-medium">복사</button>
            </div>
            <p id="replyB" class="text-sm text-gray-800 font-medium leading-relaxed">--</p>
          </div>

          <!-- Option C: 위트전환형 -->
          <div class="bg-white p-4 rounded-2xl border border-toss-border shadow-sm space-y-2 hover:border-toss-blue transition">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-purple-600 bg-purple-50 px-2.5 py-1 rounded-lg">⚡ C. 센스 부드러운형</span>
              <button onclick="copyToClipboard('replyC')" class="text-xs text-toss-greyText hover:text-toss-blue font-medium">복사</button>
            </div>
            <p id="replyC" class="text-sm text-gray-800 font-medium leading-relaxed">--</p>
          </div>
        </div>

        <!-- 대화 방향성 및 가이드 -->
        <div class="bg-amber-50 p-4 rounded-2xl border border-amber-200 space-y-1">
          <div class="text-xs font-bold text-amber-800 flex items-center space-x-1">
            <span>💡</span> <span>대화 전 꿀팁!</span>
          </div>
          <p id="resTipText" class="text-xs text-amber-900 leading-relaxed">
            --
          </p>
        </div>

        <!-- 다시 하기 버튼 -->
        <button onclick="resetApp()" class="w-full py-3.5 rounded-2xl bg-white border border-toss-border text-toss-greyText text-sm font-bold hover:bg-gray-50 transition">
          🔄 다른 대화 해독하기
        </button>

      </section>

    </main>

    <!-- Bottom Action Button Fixed -->
    <footer id="footerNav" class="bg-white px-6 py-4 border-t border-toss-border absolute bottom-0 left-0 right-0 z-20 flex space-x-3">
      <button id="prevBtn" onclick="goPrevStep()" class="hidden w-1/3 py-4 rounded-2xl bg-toss-greyBg text-toss-darkText text-base font-bold hover:bg-gray-200 transition">
        이전
      </button>
      <button id="nextBtn" onclick="goNextStep()" class="w-full py-4 rounded-2xl bg-toss-blue text-white text-base font-bold hover:bg-toss-blueHover transition shadow-md shadow-blue-200">
        다음으로
      </button>
    </footer>

    <!-- Toast Notification -->
    <div id="toast" class="fixed top-6 left-1/2 transform -translate-x-1/2 bg-gray-900/90 text-white text-xs px-4 py-2.5 rounded-full shadow-lg opacity-0 pointer-events-none transition-opacity duration-300 z-50">
      메시지가 복사되었습니다!
    </div>

  </div>

  <script>
    // Application State
    let currentStep = 1;
    const formData = {
      relation: '',
      personalities: [],
      situation: '',
      opponentMessage: '',
      emotions: [],
      myInnerFeel: ''
    };

    // UI Controls
    function updateProgress() {
      const stepTag = document.getElementById('stepProgress');
      const prevBtn = document.getElementById('prevBtn');
      const nextBtn = document.getElementById('nextBtn');
      const footerNav = document.getElementById('footerNav');

      if (currentStep <= 3) {
        footerNav.classList.remove('hidden');
        stepTag.innerText = `STEP ${currentStep} / 3`;
        prevBtn.classList.toggle('hidden', currentStep === 1);
        nextBtn.classList.toggle('w-2/3', currentStep > 1);
        nextBtn.classList.toggle('w-full', currentStep === 1);
        nextBtn.innerText = currentStep === 3 ? '해독 시작하기 🔓' : '다음으로';
      } else if (currentStep === 4) {
        footerNav.classList.add('hidden');
        stepTag.innerText = '해독 중...';
      } else if (currentStep === 5) {
        footerNav.classList.add('hidden');
        stepTag.innerText = '해독 완료 ✨';
      }

      // Hide/Show Step Screens
      document.querySelectorAll('.step-content').forEach((el, idx) => {
        if (idx + 1 === currentStep) {
          el.classList.add('active');
        } else {
          el.classList.remove('active');
        }
      });

      // Scroll to top of app container
      document.getElementById('appContainer').scrollTop = 0;
    }

    function selectRelation(btn) {
      document.querySelectorAll('.rel-btn').forEach(b => {
        b.classList.remove('bg-toss-lightBlue', 'border-toss-blue', 'text-toss-blue');
        b.classList.add('bg-white', 'border-toss-border');
      });
      btn.classList.remove('bg-white', 'border-toss-border');
      btn.classList.add('bg-toss-lightBlue', 'border-toss-blue', 'text-toss-blue');
      formData.relation = btn.getAttribute('data-val');
      document.getElementById('targetNameTag').innerText = formData.relation || '상대방';
    }

    function togglePersonality(btn, val) {
      if (formData.personalities.includes(val)) {
        formData.personalities = formData.personalities.filter(p => p !== val);
        btn.classList.remove('bg-toss-blue', 'text-white', 'border-toss-blue');
        btn.classList.add('bg-white', 'text-gray-700', 'border-toss-border');
      } else {
        formData.personalities.push(val);
        btn.classList.remove('bg-white', 'text-gray-700', 'border-toss-border');
        btn.classList.add('bg-toss-blue', 'text-white', 'border-toss-blue');
      }
    }

    function toggleEmotion(btn, val) {
      const check = btn.querySelector('.check-icon');
      if (formData.emotions.includes(val)) {
        formData.emotions = formData.emotions.filter(e => e !== val);
        btn.classList.remove('bg-toss-lightBlue', 'border-toss-blue', 'text-toss-blue');
        btn.classList.add('bg-white', 'border-toss-border');
        check.classList.add('opacity-0');
      } else {
        formData.emotions.push(val);
        btn.classList.remove('bg-white', 'border-toss-border');
        btn.classList.add('bg-toss-lightBlue', 'border-toss-blue', 'text-toss-blue');
        check.classList.remove('opacity-0');
      }
    }

    function insertSampleMessage() {
      document.getElementById('opponentMessageInput').value = "아냐, 난 진짜 괜찮으니까 너 편한 대로 해ㅋㅋ";
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.classList.remove('opacity-0', 'pointer-events-none');
      setTimeout(() => {
        toast.classList.add('opacity-0', 'pointer-events-none');
      }, 2000);
    }

    function copyToClipboard(id) {
      const text = document.getElementById(id).innerText;
      const tempTextArea = document.createElement("textarea");
      tempTextArea.value = text;
      document.body.appendChild(tempTextArea);
      tempTextArea.select();
      document.execCommand('copy');
      document.body.removeChild(tempTextArea);
      showToast('답장 문장이 복사되었어요!');
    }

    // Step Validation and Navigation
    function goNextStep() {
      if (currentStep === 1) {
        formData.situation = document.getElementById('situationInput').value.trim();
        if (!formData.relation) {
          showToast('상대와의 관계를 선택해주세요!');
          return;
        }
        if (!formData.situation) {
          showToast('상황을 간단히 설명해주세요!');
          return;
        }
      } else if (currentStep === 2) {
        formData.opponentMessage = document.getElementById('opponentMessageInput').value.trim();
        if (!formData.opponentMessage) {
          showToast('상대방이 한 말을 입력해주세요!');
          return;
        }
      } else if (currentStep === 3) {
        formData.myInnerFeel = document.getElementById('myInnerFeelInput').value.trim();
        if (formData.emotions.length === 0) {
          showToast('느끼는 감정을 1개 이상 선택해주세요!');
          return;
        }
        startDecoding();
        return;
      }

      currentStep++;
      updateProgress();
    }

    function goPrevStep() {
      if (currentStep > 1) {
        currentStep--;
        updateProgress();
      }
    }

    function resetApp() {
      currentStep = 1;
      formData.relation = '';
      formData.personalities = [];
      formData.situation = '';
      formData.opponentMessage = '';
      formData.emotions = [];
      formData.myInnerFeel = '';

      document.getElementById('situationInput').value = '';
      document.getElementById('opponentMessageInput').value = '';
      document.getElementById('myInnerFeelInput').value = '';

      document.querySelectorAll('.rel-btn').forEach(b => {
        b.classList.remove('bg-toss-lightBlue', 'border-toss-blue', 'text-toss-blue');
        b.classList.add('bg-white', 'border-toss-border');
      });
      document.querySelectorAll('.pers-btn').forEach(b => {
        b.classList.remove('bg-toss-blue', 'text-white', 'border-toss-blue');
        b.classList.add('bg-white', 'text-gray-700', 'border-toss-border');
      });
      document.querySelectorAll('.emo-btn').forEach(b => {
        b.classList.remove('bg-toss-lightBlue', 'border-toss-blue', 'text-toss-blue');
        b.classList.add('bg-white', 'border-toss-border');
        b.querySelector('.check-icon').classList.add('opacity-0');
      });

      updateProgress();
    }

    // Decoding Progress Animation & API Call
    async function startDecoding() {
      currentStep = 4;
      updateProgress();

      const loadingBar = document.getElementById('loadingBar');
      const statusText = document.getElementById('loadingStatusText');

      const statuses = [
        '문장 속에 숨겨진 감정 단어 찾는 중...',
        '상대방 성격 모델과 맥락 대입 중...',
        'F감성의 공감 문구 작성 중...',
        'T감성의 명확한 3가지 답안 생성 중...'
      ];

      let progress = 0;
      let statusIdx = 0;

      const interval = setInterval(() => {
        progress += 20;
        loadingBar.style.width = `${progress}%`;
        if (statusIdx < statuses.length) {
          statusText.innerText = statuses[statusIdx];
          statusIdx++;
        }
      }, 500);

      // Perform AI Analysis
      const result = await fetchAIAnalysis(formData);

      clearInterval(interval);
      loadingBar.style.width = '100%';

      setTimeout(() => {
        renderResults(result);
        currentStep = 5;
        updateProgress();
      }, 400);
    }

    // Render Gemini / Simulation Output
    function renderResults(data) {
      document.getElementById('resEmpathyText').innerText = data.empathy;
      document.getElementById('resSummaryText').innerText = data.summary;
      document.getElementById('resOriginalMsg').innerText = formData.opponentMessage;
      document.getElementById('resDecodedText').innerText = data.decodedMeaning;
      document.getElementById('replyA').innerText = data.replies.A;
      document.getElementById('replyB').innerText = data.replies.B;
      document.getElementById('replyC').innerText = data.replies.C;
      document.getElementById('resTipText').innerText = data.tip;
    }

    async function fetchAIAnalysis(data) {
      // Prompt construction for Gemini API
      const systemPrompt = `당신은 대한민국 초/중/고 학생들의 갈등을 해결해주는 따뜻하고 명쾌한 '대화 암호 해독 AI 코치'입니다.
말투는 토스(Toss) 스타일로 친근하고 명확하며, 마음에는 깊이 공감해주고(F감성), 해결책은 깔끔하고 명확하게(T방식) 제공합니다.

반드시 지정된 JSON 형식으로만 응답해야 합니다.

JSON schema:
{
  "empathy": "학생의 속상함과 마음을 온전히 위로하고 공감해주는 2~3문장의 F감성 따뜻한 메시지",
  "summary": "현재 상황과 핵심 갈등 요점 정리 (2문장)",
  "decodedMeaning": "상대방 말이 가진 진짜 속뜻/숨겨진 심리 해독 (2~3문장)",
  "replies": {
    "A": "공감과 다정함을 강조한 맞춤 답장 문장",
    "B": "솔직하고 담백하게 오해를 푸는 답장 문장",
    "C": "장난스럽거나 자연스럽게 분위기를 전환하는 센스있는 답장 문장"
  },
  "tip": "대화를 이어갈 때 주의할 점이나 타이밍 꿀팁"
}`;

      const userQuery = `
[갈등 분석 요청]
- 상대와의 관계: ${data.relation}
- 상대방 성격: ${data.personalities.join(', ') || '보통'}
- 갈등 상황: ${data.situation}
- 상대방이 한 말: "${data.opponentMessage}"
- 나의 감정: ${data.emotions.join(', ')}
- 나의 원하는 속마음: ${data.myInnerFeel || '오해를 풀고 잘 지내고 싶음'}
`;

      // API Key retrieval safely
      let apiKey = "";
      try {
        if (typeof window !== 'undefined' && window.process && window.process.env) {
          apiKey = window.process.env.GEMINI_API_KEY || "";
        }
      } catch (e) {
        apiKey = "";
      }

      if (apiKey) {
        try {
          const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              contents: [{ parts: [{ text: userQuery }] }],
              systemInstruction: { parts: [{ text: systemPrompt }] },
              generationConfig: {
                responseMimeType: "application/json"
              }
            })
          });

          if (response.ok) {
            const resJson = await response.json();
            const textContent = resJson.candidates?.[0]?.content?.parts?.[0]?.text;
            if (textContent) {
              return JSON.parse(textContent);
            }
          }
        } catch (err) {
          console.warn("Gemini API call failed, switching to high-quality fallback simulation.", err);
        }
      }

      // Fallback Simulation Engine (High quality responses when API Key is absent)
      return generateFallbackResult(data);
    }

    function generateFallbackResult(data) {
      const rel = data.relation || '친구';
      const msg = data.opponentMessage;
      const emos = data.emotions.join('과 ') || '답답함';

      return {
        empathy: `${rel}와의 문제 때문에 많이 마음고생했겠어요. ${emos}을(를) 느끼면서도 먼저 오해를 풀고 관계를 지키려는 마음이 정말 대단하고 따뜻해요. 마음이 상한 자신을 먼저 안아주세요!`,
        summary: `상대방(${rel})은 현재 상황에서 직설적으로 표현하기보다는 서운함이나 자존심 때문에 방어적인 태도를 취하고 있어요.`,
        decodedMeaning: `"${msg}"라는 말은 진짜 괜찮다는 뜻이 아니라, '내 맘을 먼저 알아주고 사과해주면 좋겠어' 또는 '자존심 때문에 속마음을 숨기는 중이야'라는 서운함의 암호일 확률이 높아요!`,
        replies: {
          A: `아까 네 말 듣고 마음이 걸려서 계속 생각했어. 혹시 내가 실수해서 서운하게 한 거 있다면 솔직하게 말해주라, 네 마음이 제일 중요해!`,
          B: `까놓고 말해서 아까는 상황이 꼬여서 제대로 말을 못했어. 오해 없이 잘 풀고 싶은데 편할 때 잠깐 얘기할 수 있을까?`,
          C: `아까 내 반응 때문에 삐진 거 아니지?! 😭 맛있는 거 사줄 테니까 기분 풀고 속마음 털어놔라~!`
        },
        tip: "톡으로 장문의 글을 보내는 것보다는 상대방의 기분이 조금 가라앉았을 때(저녁 시간대 추천) 담백하게 먼저 말을 건네보는 것이 훨씬 효과적이에요."
      };
    }
  </script>
</body>
