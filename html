    // UI Utilities
    function updateProgress(step) {
      const bar = document.getElementById('progressBar');
      bar.style.width = `${(step / 5) * 100}%`;
    }

    function goToStep(stepNum) {
      // Hide all steps
      [1, 2, 3, 4, 5].forEach(num => {
        const el = document.getElementById(`step${num}`);
        if (el) el.classList.add('hidden');
      });

      // Show target step
      const target = document.getElementById(`step${stepNum}`);
      if (target) target.classList.remove('hidden');

      updateProgress(stepNum);

      // Actions per step
      if (stepNum === 2) {
        updatePresetWords();
        const display = document.getElementById('partnerNameDisplay');
        display.innerText = state.relation || '상대방';
      }
    }

    function resetToStep1() {
      state.relation = '';
      state.traits = [];
      state.partnerWords = '';
      state.emotions = [];
      state.userInner = '';
      state.report = null;

      // Reset DOM elements
      document.querySelectorAll('.relation-btn').forEach(btn => {
        btn.classList.remove('border-tossBlue', 'bg-blue-50/50');
        btn.querySelector('.check-icon')?.classList.add('opacity-0');
      });
      document.querySelectorAll('.trait-badge').forEach(badge => {
        badge.classList.remove('bg-tossBlue', 'text-white', 'border-tossBlue');
      });
      document.querySelectorAll('.emotion-btn').forEach(btn => {
        btn.classList.remove('border-tossBlue', 'bg-blue-50/50');
      });

      document.getElementById('targetWords').value = '';
      document.getElementById('userInnerFeeling').value = '';

      checkStep1Valid();
      checkStep2Valid();
      checkStep3Valid();

      goToStep(1);
    }

    // Step 1 Functions
    function selectRelation(rel, btn) {
      state.relation = rel;
      document.querySelectorAll('.relation-btn').forEach(b => {
        b.classList.remove('border-tossBlue', 'bg-blue-50/50');
        b.querySelector('.check-icon')?.classList.add('opacity-0');
      });
      btn.classList.add('border-tossBlue', 'bg-blue-50/50');
      btn.querySelector('.check-icon')?.classList.remove('opacity-0');

      checkStep1Valid();
    }

    function toggleTrait(trait, btn) {
      const idx = state.traits.indexOf(trait);
      if (idx > -1) {
        state.traits.splice(idx, 1);
        btn.classList.remove('bg-tossBlue', 'text-white', 'border-tossBlue');
      } else {
        state.traits.push(trait);
        btn.classList.add('bg-tossBlue', 'text-white', 'border-tossBlue');
      }
    }

    function checkStep1Valid() {
      const btn = document.getElementById('step1NextBtn');
      if (state.relation) {
        btn.disabled = false;
        btn.classList.remove('bg-tossLightBg', 'text-tossSubText', 'cursor-not-allowed');
        btn.classList.add('bg-tossBlue', 'text-white', 'hover:bg-tossBlueHover', 'shadow-sm');
      } else {
        btn.disabled = true;
        btn.classList.add('bg-tossLightBg', 'text-tossSubText', 'cursor-not-allowed');
        btn.classList.remove('bg-tossBlue', 'text-white', 'hover:bg-tossBlueHover', 'shadow-sm');
      }
    }

    // Step 2 Functions
    function updatePresetWords() {
      const container = document.getElementById('presetWordsContainer');
      container.innerHTML = '';
      const list = PRESETS[state.relation] || PRESETS['친구'];

      list.forEach(text => {
        const chip = document.createElement('button');
        chip.className = 'text-left text-xs p-2.5 rounded-xl border border-tossBorder hover:bg-tossLightBg text-tossDarkText transition-all font-medium flex items-center justify-between group';
        chip.innerHTML = `<span>"${text}"</span> <i class="ph-bold ph-plus text-tossSubText group-hover:text-tossBlue"></i>`;
        chip.onclick = () => {
          document.getElementById('targetWords').value = text;
          state.partnerWords = text;
          checkStep2Valid();
        };
        container.appendChild(chip);
      });
    }

    document.getElementById('targetWords')?.addEventListener('input', (e) => {
      state.partnerWords = e.target.value.trim();
      checkStep2Valid();
    });

    function checkStep2Valid() {
      const btn = document.getElementById('step2NextBtn');
      const val = document.getElementById('targetWords').value.trim();
      if (val.length >= 2) {
        btn.disabled = false;
        btn.classList.remove('bg-tossLightBg', 'text-tossSubText', 'cursor-not-allowed');
        btn.classList.add('bg-tossBlue', 'text-white', 'hover:bg-tossBlueHover', 'shadow-sm');
      } else {
        btn.disabled = true;
        btn.classList.add('bg-tossLightBg', 'text-tossSubText', 'cursor-not-allowed');
        btn.classList.remove('bg-tossBlue', 'text-white', 'hover:bg-tossBlueHover', 'shadow-sm');
      }
    }

    // Step 3 Functions
    function toggleEmotion(emo, btn) {
      const idx = state.emotions.indexOf(emo);
      if (idx > -1) {
        state.emotions.splice(idx, 1);
        btn.classList.remove('border-tossBlue', 'bg-blue-50/50');
      } else {
        state.emotions.push(emo);
        btn.classList.add('border-tossBlue', 'bg-blue-50/50');
      }
      checkStep3Valid();
    }

    function checkStep3Valid() {
      const btn = document.getElementById('step3NextBtn');
      if (state.emotions.length > 0) {
        btn.disabled = false;
        btn.classList.remove('bg-tossLightBg', 'text-tossSubText', 'cursor-not-allowed');
        btn.classList.add('bg-tossBlue', 'text-white', 'hover:bg-tossBlueHover', 'shadow-sm');
      } else {
        btn.disabled = true;
        btn.classList.add('bg-tossLightBg', 'text-tossSubText', 'cursor-not-allowed');
        btn.classList.remove('bg-tossBlue', 'text-white', 'hover:bg-tossBlueHover', 'shadow-sm');
      }
    }

    // Step 4 & Gemini Integration
    async function startDecoding() {
      state.userInner = document.getElementById('userInnerFeeling').value.trim();
      goToStep(4);

      // Loading step animation simulation
      setTimeout(() => updateLoadingStep(1), 600);
      setTimeout(() => updateLoadingStep(2), 1400);
      setTimeout(() => updateLoadingStep(3), 2200);

      try {
        const result = await fetchGeminiAnalysis();
        state.report = result;
      } catch (err) {
        console.warn("Gemini API 호출 미사용 또는 오류로 Fallback 심리 분석 엔진 작동:", err);
        state.report = generateFallbackAnalysis();
      }

      setTimeout(() => {
        renderReport();
        goToStep(5);
      }, 3000);
    }

    function updateLoadingStep(num) {
      const icon = document.getElementById(`icon${num}`);
      const text = document.getElementById(`loadCheck${num}`);
      if (icon && text) {
        icon.className = 'ph-bold ph-check-circle text-tossBlue text-base';
        text.classList.remove('text-tossSubText');
        text.classList.add('text-tossDarkText', 'font-semibold');
      }
    }

    // Call Gemini API
    async function fetchGeminiAnalysis() {
      const systemPrompt = `
      당신은 청소년 및 대학생의 심리와 가족/인간관계를 전문으로 다루는 저명한 상담 심리학자이자 관계 치료사입니다.
      사용자가 전달한 [상대방과의 관계], [상대 성향], [상대가 한 말], [사용자가 느낀 감정]을 심도 있게 분석하세요.

      [중요 규칙]
      1. '괜찮아 = 안 괜찮아' 같은 뻔하고 장난스러운 억지 드립이나 상투적 해석을 절대 하지 마세요.
      2. 특히 [부모님/가족 갈등]에서는 권위주의와 자율성 충돌, 성적/학업/진로 부담, 부모의 통제욕 뒤에 숨겨진 불안감, 소통 방식 차이 등 깊이 있는 심리학적 맥락을 반영하세요.
      3. [친구/연인 갈등]에서는 자존심, 관계 소외감, 감정 소모 피로도 등 미묘한 또래 관계 심리를 정밀 분석하세요.
      4. 응답은 반드시 지정된 JSON 형식으로만 반환하세요.
      `;

      const userPrompt = `
      - 상대와의 관계: ${state.relation}
      - 상대의 성향: ${state.traits.join(', ') || '특별한 성향 언급 없음'}
      - 상대가 한 말: "${state.partnerWords}"
      - 내가 느낀 감정: ${state.emotions.join(', ')}
      - 내가 솔직히 전하고 싶었던 마음: "${state.userInner || '없음'}"

      위 내용을 바탕으로 JSON으로 응답해 주세요.
      `;

      const apiKey = ""; // Canvas Runtime provides key if configured
      const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

      const payload = {
        contents: [{ parts: [{ text: userPrompt }] }],
        systemInstruction: { parts: [{ text: systemPrompt }] },
        generationConfig: {
          responseMimeType: "application/json",
          responseSchema: {
            type: "OBJECT",
            properties: {
              empathyText: { type: "STRING", description: "학생의 상처받은 마음을 깊이 헤아리는 따뜻한 공감 문장 (2~3문장)" },
              hiddenMeaning: { type: "STRING", description: "상대방 말이 나타내는 진짜 심리학적 속뜻과 의도 (깊이 있는 분석 3~4문장)" },
              deepPsychology: { type: "STRING", description: "왜 이런 표현 방식(공격성, 회피 등)이 나왔는지에 대한 심리 역학 설명" },
              solutions: {
                type: "ARRAY",
                items: {
                  type: "OBJECT",
                  properties: {
                    type: { type: "STRING", description: "대답 유형: '감정 완화형', '진심 전달형', '대화 물꼬 터주기형'" },
                    script: { type: "STRING", description: "실제 말할 수 있는 구체적인 문장" },
                    explanation: { type: "STRING", description: "이 표현이 효과적인 이유" }
                  },
                  required: ["type", "script", "explanation"]
                }
              },
              actionGuide: { type: "STRING", description: "학생 스스로의 마음 건강과 향후 대화 방향을 위한 조언" }
            },
            required: ["empathyText", "hiddenMeaning", "deepPsychology", "solutions", "actionGuide"]
          }
        }
      };

      const res = await fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const json = await res.json();
      const textResult = json.candidates?.[0]?.content?.parts?.[0]?.text;
      if (textResult) {
        return JSON.parse(textResult);
      }
      throw new Error("Invalid API response format");
    }

